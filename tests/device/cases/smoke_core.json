     "expect": {"result.serverInfo.name": "Xosvi", "result.protocolVersion": {"min_len": 5}}},
    {"id": "ping", "method": "ping", "params": {}, "expect": {"result": {}}},
    {"id": "tools_list", "method": "tools/list", "params": {},
     "expect": {"result.tools": {"min_len": 20}}},
